<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.8.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#Base" name="5"/>
  <main name="R32_CPU"/>
  <options>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="5" map="Button2" name="Menu Tool"/>
    <tool lib="5" map="Button3" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="5" name="Poke Tool"/>
    <tool lib="5" name="Edit Tool"/>
    <tool lib="5" name="Wiring Tool"/>
    <tool lib="5" name="Text Tool"/>
  </toolbar>
  <circuit name="R32_CPU">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="R32_CPU"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <a name="tickFrequency" val="1.0"/>
    <comp lib="0" loc="(120,200)" name="Clock"><a name="label" val="CLK"/></comp><comp lib="4" loc="(320,200)" name="Register"><a name="label" val="PC"/><a name="width" val="16"/></comp><comp lib="3" loc="(200,300)" name="Adder"><a name="label" val="PC + 1"/><a name="width" val="16"/></comp><comp lib="2" loc="(480,330)" name="Multiplexer"><a name="label" val="MUX PC suivant"/><a name="select bits" val="2"/><a name="width" val="16"/></comp><comp lib="4" loc="(700,200)" name="ROM"><a name="label" val="ROM programme 32K×32"/><a name="addrWidth" val="15"/><a name="dataWidth" val="32"/></comp><comp lib="2" loc="(920,200)" name="Splitter"><a name="bit width" val="32"/><a name="fanout" val="3"/><a name="output" val="none"/></comp><comp lib="0" loc="(940,330)" name="Constant"><a name="width" val="4"/><a name="value" val="0xf"/></comp><comp lib="4" loc="(700,560)" name="ROM"><a name="label" val="ROM contrôle 256×24"/><a name="addrWidth" val="8"/><a name="dataWidth" val="24"/></comp><comp lib="2" loc="(940,560)" name="Decoder"><a name="label" val="DECODE sauts"/><a name="select bits" val="4"/></comp><comp lib="1" loc="(1140,520)" name="AND Gate"><a name="width" val="1"/></comp><comp lib="1" loc="(1140,570)" name="OR Gate"><a name="width" val="1"/></comp><comp lib="1" loc="(1050,620)" name="NOT Gate"><a name="width" val="1"/></comp><comp lib="4" loc="(1300,560)" name="Register"><a name="label" val="Flags ZNVC"/><a name="width" val="4"/><a name="trigger" val="falling"/></comp><comp lib="4" loc="(300,870)" name="RAM"><a name="label" val="RAM regs (port A)"/><a name="addrWidth" val="4"/><a name="dataWidth" val="16"/></comp><comp lib="4" loc="(300,1030)" name="RAM"><a name="label" val="RAM regs (port B)"/><a name="addrWidth" val="4"/><a name="dataWidth" val="16"/></comp><comp lib="2" loc="(540,900)" name="Multiplexer"><a name="label" val="adr A (rd/SP/LR)"/><a name="select bits" val="2"/><a name="width" val="4"/></comp><comp lib="2" loc="(540,1000)" name="Multiplexer"><a name="label" val="adr B (rs/SP/rd)"/><a name="select bits" val="2"/><a name="width" val="4"/></comp><comp lib="2" loc="(540,1100)" name="Multiplexer"><a name="label" val="adr W (rd/SP)"/><a name="select bits" val="1"/><a name="width" val="4"/></comp><comp lib="0" loc="(460,940)" name="Constant"><a name="label" val="R13=SP"/><a name="width" val="4"/><a name="value" val="0xd"/></comp><comp lib="0" loc="(460,980)" name="Constant"><a name="label" val="R14=LR"/><a name="width" val="4"/><a name="value" val="0xe"/></comp><comp lib="3" loc="(760,850)" name="Adder"><a name="label" val="ADD"/><a name="width" val="16"/></comp><comp lib="3" loc="(760,930)" name="Subtractor"><a name="label" val="SUB"/><a name="width" val="16"/></comp><comp lib="1" loc="(760,1010)" name="AND Gate"><a name="width" val="16"/></comp><comp lib="1" loc="(760,1070)" name="OR Gate"><a name="width" val="16"/></comp><comp lib="1" loc="(760,1130)" name="XOR Gate"><a name="width" val="16"/></comp><comp lib="3" loc="(960,850)" name="Shifter"><a name="label" val="SHL"/><a name="width" val="16"/></comp><comp lib="3" loc="(960,930)" name="Shifter"><a name="label" val="SHR"/><a name="width" val="16"/></comp><comp lib="2" loc="(1140,990)" name="Multiplexer"><a name="label" val="MUX résultat ALU"/><a name="select bits" val="3"/><a name="width" val="16"/></comp><comp lib="2" loc="(1140,850)" name="Multiplexer"><a name="label" val="opérande B (rb/imm)"/><a name="select bits" val="1"/><a name="width" val="16"/></comp><comp lib="4" loc="(700,1380)" name="RAM"><a name="label" val="RAM données"/><a name="addrWidth" val="16"/><a name="dataWidth" val="16"/></comp><comp lib="2" loc="(480,1360)" name="Multiplexer"><a name="label" val="adr (imm/rb/ALU)"/><a name="select bits" val="2"/><a name="width" val="16"/></comp><comp lib="2" loc="(960,1500)" name="Multiplexer"><a name="label" val="WB (ALU/RAM/PC+1)"/><a name="select bits" val="2"/><a name="width" val="16"/></comp>
    <comp lib="5" loc="(60,60)" name="Text"><a name="text" val="ZONE 1 — FETCH (séquencement)"/><a name="font" val="SansSerif bold 16"/></comp><comp lib="5" loc="(60,85)" name="Text"><a name="text" val="Le PC de Logisim compte les INSTRUCTIONS (pas les mots)."/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(60,100)" name="Text"><a name="text" val="PC_mots = 2 × PC_logisim. Chaque ROM 32 bits = 1 instruction (W0 + W1)."/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(280,165)" name="Text"><a name="text" val="Registre 16 bits, chargé à chaque coup d'horloge"/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(430,290)" name="Text"><a name="text" val="00=PC+1  01=imm16 (saut)  10=LR (RET)"/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(640,165)" name="Text"><a name="text" val="Clic droit &gt; Load Image : charger build/xxx_logisim.hex"/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(850,165)" name="Text"><a name="text" val="Splitter : W0[15:0] -&gt; opcode[7:0] rd[11:8] rs[15:12]"/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(850,180)" name="Text"><a name="text" val="           W1[31:16] = imm16"/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(60,420)" name="Text"><a name="text" val="ZONE 2 — DÉCODAGE ET CONTRÔLE (le moteur figé)"/><a name="font" val="SansSerif bold 16"/></comp><comp lib="5" loc="(60,445)" name="Text"><a name="text" val="La ROM de contrôle est une fonction pure de l'opcode : adresse=opcode, sortie=mot 24 bits."/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(60,460)" name="Text"><a name="text" val="Voir LOGISIM.md pour la table complète (copier-coller dans l'éditeur de la ROM)."/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(880,525)" name="Text"><a name="text" val="opcode[3:0] : 1=JMP 2=JZ 3=JNZ 4=JN 5=JC 6=JV"/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(1240,525)" name="Text"><a name="text" val="Chargé quand we_flags=1 (bits V Z N C de l'ALU)"/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(60,700)" name="Text"><a name="text" val="ZONE 3 — BANC DE REGISTRES (16 × 16 bits, 2 lectures + 1 écriture)"/><a name="font" val="SansSerif bold 16"/></comp><comp lib="5" loc="(60,725)" name="Text"><a name="text" val="Deux RAM 16×16 identiques (ports A et B) écrites ensemble = 2 ports de lecture."/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(60,740)" name="Text"><a name="text" val="L'écriture dans R0 est bloquée par we_regfile AND (wr_addr != 0)."/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(700,700)" name="Text"><a name="text" val="ZONE 4 — ALU 16 bits"/><a name="font" val="SansSerif bold 16"/></comp><comp lib="5" loc="(700,725)" name="Text"><a name="text" val="alu_op[2:0] : 0=PASS B  1=ADD  2=SUB  3=AND  4=OR  5=XOR  6=SHL  7=SHR"/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(60,1220)" name="Text"><a name="text" val="ZONE 5 — MÉMOIRE DONNÉES 64K×16 + ECRITURE REGISTRES"/><a name="font" val="SansSerif bold 16"/></comp><comp lib="5" loc="(300,1550)" name="Text"><a name="text" val="we_mem=1 : écrit ra dans RAM[adr]   |   we_regfile=1 : RF[adr W] &lt;- WB"/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(700,1220)" name="Text"><a name="text" val="ZONE 6 — MMIO (0xF000-0xFFFF) : UART + debug décimal"/><a name="font" val="SansSerif bold 16"/></comp><comp lib="5" loc="(700,1245)" name="Text"><a name="text" val="adr &gt;= 0xF000 : rediriger vers les registres UART (FPGA : décodeur d'adresses)."/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(700,1260)" name="Text"><a name="text" val="0xF000=data  0xF001=status  0xF002=debug décimal"/><a name="font" val="SansSerif 13 11"/></comp><comp lib="5" loc="(60,1650)" name="Text"><a name="text" val="LÉGENDE DU MOT DE CONTRÔLE (24 bits)"/><a name="font" val="SansSerif bold 16"/></comp><comp lib="5" loc="(60,1675)" name="Text"><a name="text" val="[23:20] alu_op   [19] halt   [18] branch   [17:16] pc_src (00=PC+1, 01=imm16, 10=LR)"/><a name="font" val="SansSerif 13 12"/></comp><comp lib="5" loc="(60,1693)" name="Text"><a name="text" val="[15:14] wb_sel (00=ALU, 01=RAM, 10=PC+1)   [13] we_mem   [12] we_flags   [11] we_regfile"/><a name="font" val="SansSerif 13 12"/></comp><comp lib="5" loc="(60,1711)" name="Text"><a name="text" val="[10] alu_b_sel (0=rb, 1=imm16)   [9:8] mem_addr (00=imm, 01=rb, 10=ALU)"/><a name="font" val="SansSerif 13 12"/></comp><comp lib="5" loc="(60,1729)" name="Text"><a name="text" val="[7:6] ra_addr (00=rd, 01=SP, 10=LR)   [5:4] rb_addr (00=rs, 01=SP, 10=rd)   [3] wr_addr (0=rd, 1=SP)"/><a name="font" val="SansSerif 13 12"/></comp><comp lib="5" loc="(60,1747)" name="Text"><a name="text" val="POP (0x1A) = seule instruction à 2 coups d'horloge : voir LOGISIM.md (état FSM)."/><a name="font" val="SansSerif 13 12"/></comp>
  </circuit>
</project>