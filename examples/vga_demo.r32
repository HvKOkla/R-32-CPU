__jin_mul16:            ; R2*R3 -> R1 (additions répétées)
    PUSH R4
    PUSH R5
    MOV R4, R2
    MOV R5, R3
    MOV R1, 0
__jin_mul_loop:
    CMPI R5, 0
    JZ __jin_mul_done
    ADD R1, R4
    DEC R5
    JMP __jin_mul_loop
__jin_mul_done:
    POP R5
    POP R4
    RET

__jin_div16:            ; R2/R3 -> R1 (quotient), R3 (reste)
    PUSH R4
    PUSH R5
    MOV R4, R2
    MOV R5, R3
    MOV R1, 0
    CMPI R5, 0
    JZ __jin_div_done    ; div par 0 -> quotient 0, reste R2
__jin_div_loop:
    CMP R4, R5
    JN __jin_div_done
    SUB R4, R5
    INC R1
    JMP __jin_div_loop
__jin_div_done:
    MOV R3, R4
    POP R5
    POP R4
    RET


